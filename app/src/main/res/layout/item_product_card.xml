<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.FlowMart.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Product Image Container (4:5 Aspect Feel) with Overlays -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/product_card_image_height"
            android:background="@color/surface_variant">

            <ImageView
                android:id="@+id/iv_product"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_product_placeholder" />

            <!-- Top-Left Discount Badge -->
            <TextView
                android:id="@+id/tv_discount_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:background="@drawable/bg_badge_discount"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="20% OFF"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Top-Right Wishlist Heart Button -->
            <ImageButton
                android:id="@+id/btn_wishlist"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_circle_surface"
                android:contentDescription="Wishlist"
                android:padding="7dp"
                android:src="@drawable/ic_heart_outline" />

            <!-- Bottom-Left Rating Pill -->
            <LinearLayout
                android:id="@+id/layout_rating_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="8dp"
                android:background="@drawable/bg_badge_rating"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp">

                <TextView
                    android:id="@+id/tv_rating_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.3"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="2dp"
                    android:contentDescription="Star"
                    android:src="@drawable/ic_star_small" />
            </LinearLayout>

            <!-- Out of Stock / Low Stock Scrim Overlay -->
            <TextView
                android:id="@+id/tv_stock_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@color/scrim_dark"
                android:gravity="center"
                android:paddingVertical="4dp"
                android:text="@string/out_of_stock"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>

        <!-- Product Details Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/tv_brand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="LUX WHOLESALE" />

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:lines="2"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Cotton White Vest (Wholesale Pack of 10)" />

            <!-- Price Row: Selling Price + Strike MRP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_price"
                    style="@style/TextAppearance.FlowMart.Price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="₹95" />

                <TextView
                    android:id="@+id/tv_mrp_strike"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/text_strike"
                    android:textSize="11sp"
                    tools:text="₹120" />

                <TextView
                    android:id="@+id/tv_unit_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="/pc"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Wholesale MOQ & Pack Badge -->
            <TextView
                android:id="@+id/tv_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_badge_moq"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="Min Order: 20 pcs • Pack of 10" />

            <!-- Quick Add to Cart Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_cart"
                style="@style/Widget.FlowMart.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="+ Add Wholesale Pack"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>